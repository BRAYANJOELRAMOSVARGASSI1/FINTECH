# FinEngine Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=FinEngine
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql+asyncpg://finengine:finengine_secret@localhost:5432/finengine_db

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Monte Carlo
MONTE_CARLO_DEFAULT_ITERATIONS=10000
